{
  "rewrites": [
    { "source": "/msx/app", "destination": "/index.html" },
    { "source": "/msx/app/", "destination": "/index.html" },
    { "source": "/msx/standalone", "destination": "/index.html" },
    { "source": "/msx/standalone/", "destination": "/index.html" },
    { "source": "/msx/app/:path*", "destination": "/:path*" },
    { "source": "/msx/start.json", "destination": "/api/msx/start.json" },
    { "source": "/msx/link.json", "destination": "/api/msx/link.json" },
    { "source": "/msx/launch.json", "destination": "/api/msx/launch.json" },
    { "source": "/msx/menu", "destination": "/api/msx/menu" },
    { "source": "/msx/enter", "destination": "/api/msx/enter" },
    { "source": "/msx/categories", "destination": "/api/msx/categories" },
    { "source": "/msx/items", "destination": "/api/msx/items" },
    { "source": "/msx/series", "destination": "/api/msx/series" },
    { "source": "/msx/diag-ping", "destination": "/api/msx/diag-ping" },
    { "source": "/msx/diag-api", "destination": "/api/msx/diag-api" }
  ],
  "headers": [
    {
      "source": "/msx/diag/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
